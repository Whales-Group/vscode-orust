{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ORust",
  "scopeName": "source.orust",
  "patterns": [
    { "include": "#comments" },
    { "include": "#documentation" },
    { "include": "#annotations" },
    { "include": "#rust" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.documentation.orust", "match": "///.*$" },
        { "name": "comment.line.double-slash.orust", "match": "//.*$" },
        { "name": "comment.block.orust", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "documentation": {
      "patterns": [{ "name": "entity.name.tag.documentation.orust", "match": "@[A-Za-z][A-Za-z0-9_]*" }]
    },
    "annotations": {
      "patterns": [{ "name": "storage.type.annotation.orust", "match": "@[A-Za-z][A-Za-z0-9_]*(?=\\s*\\()" }]
    },
    "rust": {
      "name": "meta.embedded.rust.orust",
      "begin": "\\brust\\s*\\{",
      "end": "\\}",
      "patterns": [{ "include": "source.rust" }]
    },
    "strings": {
      "name": "string.quoted.double.orust",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.orust", "match": "\\\\." }]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.orust", "match": "\\b\\d+(?:\\.\\d+)?\\b" }]
    },
    "keywords": {
      "patterns": [{
        "name": "keyword.control.orust",
        "match": "\\b(?:class|interface|enum|error|typedef|type|extends|implements|export|import|show|hide|as|package|shared|var|new|return|if|else|while|for|in|void|lend|copy|rust|async|await|throws|try|catch|switch|case|default|on|drop|unsafe|match|true|false|null)\\b"
      }]
    },
    "types": {
      "patterns": [{
        "name": "storage.type.orust",
        "match": "\\b(?:int|double|bool|char|String|List|Map|Set|Option|Result|Future|Stream|Self)\\b"
      }]
    },
    "functions": {
      "patterns": [{ "name": "entity.name.function.orust", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" }]
    },
    "operators": {
      "patterns": [{ "name": "keyword.operator.orust", "match": "(?:=>|==|!=|<=|>=|\\+|-|\\*|/|=|<|>)" }]
    }
  }
}
